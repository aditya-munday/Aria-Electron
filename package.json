{
  "name": "aria-desktop",
  "version": "0.8.0",
  "private": true,
  "description": "Aria — the local-first voice assistant desktop client (Electron).",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-renderer.mjs && node scripts/bundle-renderer.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run typecheck && npm run test && npm run build && npm run security:check && npm run preflight",
    "security:check": "node scripts/security-check.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "pack:deb": "npm run build && npm run build:sidecar && electron-builder --linux deb --x64 --publish never",
    "smoke:deb": "npm run pack:deb && npm run security:check && npm run verify:package && node scripts/smoke-deb.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@voxrt/wake-word-browser": "0.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "author": {
    "name": "Aditya Munday",
    "email": "dev@adityamunday.codes"
  },
  "homepage": "https://adityamunday.codes",
  "build": {
    "appId": "dev.adityamunday.aria",
    "productName": "Aria",
    "artifactName": "aria-electron_${version}_${arch}.deb",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/**/*.d.ts",
      "!node_modules/**/*.ts",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/sidecar/aria-voice",
        "to": "sidecar/aria-voice"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Aditya Munday <dev@adityamunday.codes>",
      "synopsis": "Aria - the local-first voice assistant desktop client",
      "description": "Aria is the Linux-native desktop client of the Aria /v1 wire contract. Control Center, Orb presence, chat surface and honest stop/mute/interrupt/recovery controls.",
      "executableName": "aria-desktop",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libdrm2",
        "libgbm1",
        "libasound2"
      ],
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    }
  },
  "desktopName": "aria-desktop.desktop"
}
